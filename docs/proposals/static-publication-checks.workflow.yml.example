# INACTIVE: publish/pin this template only after separate explicit CI approval.
name: Approved static publication checks
on:
  workflow_dispatch:
    inputs:
      source_sha:
        description: Exact separately approved published source commit
        required: true
        type: string
permissions:
  contents: read
jobs:
  publisher:
    if: github.repository == 'alvarovillalbaa/clero' && github.ref == 'refs/heads/main' && github.event.repository.private == false
    runs-on: ubuntu-24.04
    timeout-minutes: 5
    env:
      APPROVED_SOURCE_SHA: APPROVED_SOURCE_SHA
      SOURCE_SHA: ${{ inputs.source_sha }}
    steps:
      - name: Require the separately approved source
        shell: bash
        run: '[[ "$SOURCE_SHA" =~ ^[0-9a-f]{40}$ && "$SOURCE_SHA" == "$APPROVED_SOURCE_SHA" ]]'
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
        with:
          ref: ${{ inputs.source_sha }}
          persist-credentials: false
      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020
        with:
          node-version: 24.21.0
      - name: Verify source, run exactly 72 checks, verify source and clean owned fixtures
        shell: bash
        run: |
          node --input-type=module <<'NODE'
          import fs from 'node:fs';
          import path from 'node:path';
          import assert from 'node:assert/strict';
          import { randomUUID } from 'node:crypto';
          import { execFileSync, spawn } from 'node:child_process';
          const tests = ['tests/model.test.mjs', 'tests/markdown.test.mjs', 'tests/routes.test.mjs', 'tests/publication.test.mjs', 'tests/cli.test.mjs'];
          const sizes = [16, 18, 8, 16, 14], seal = 'docs/results/2026/10-31/static-publication-checks-source.json';
          const git = (...args) => execFileSync('git', args, { maxBuffer: 8 * 1024 * 1024 });
          const equal = (a, b) => assert.deepEqual(a, b), sorted = list => [...list].sort();
          let expected, root, owner, marker, markerOwner, token, fixtures, fixtureOwner, failed = false;
          const outcome = { started: false, exitCode: null, signal: null, timedOut: false, stopReason: null, stdoutBytes: 0, stderrBytes: 0 };
          function sourceGuard() {
            assert.equal(git('rev-parse', 'HEAD').toString().trim(), process.env.APPROVED_SOURCE_SHA);
            equal(fs.readFileSync(seal), git('show', `HEAD:${seal}`));
            const manifest = JSON.parse(fs.readFileSync(seal, 'utf8'));
            const indexed = git('ls-files', '--stage', '-z').toString().split('\0').filter(Boolean).map(line => {
              const tab = line.indexOf('\t'), [mode, gitSha, stage] = line.slice(0, tab).split(' ');
              assert.equal(stage, '0'); return { path: line.slice(tab + 1), mode, gitSha };
            }).filter(file => !file.path.startsWith('docs/results/'));
            const byPath = list => [...list].sort((a, b) => a.path < b.path ? -1 : a.path > b.path ? 1 : 0);
            equal(byPath(indexed), byPath(manifest.files));
            for (const file of indexed) {
              const parts = file.path.split('/'); assert.ok(!path.isAbsolute(file.path) && parts.every(part => part && part !== '.' && part !== '..'));
              for (let n = 1; n < parts.length; n++) { const parent = fs.lstatSync(parts.slice(0, n).join('/')); assert.ok(parent.isDirectory() && !parent.isSymbolicLink()); }
              const stat = fs.lstatSync(file.path);
              const mode = stat.isSymbolicLink() ? '120000' : stat.isFile() ? (stat.mode & 0o111 ? '100755' : '100644') : 'invalid';
              assert.equal(mode, file.mode);
              equal(mode === '120000' ? fs.readlinkSync(file.path, { encoding: 'buffer' }) : fs.readFileSync(file.path), git('show', `HEAD:${file.path}`));
            }
            equal(sorted(manifest.testFiles.map(file => file.path)), sorted(tests));
            expected = tests.flatMap((name, index) => { const names = manifest.testFiles.find(file => file.path === name).names; assert.equal(names.length, sizes[index]); return names; });
            assert.ok(expected.every(name => typeof name === 'string' && name.length > 0 && name.length <= 512));
            assert.equal(new Set(expected).size, 72);
          }
          function owned(directory, identity) {
            const actual = fs.lstatSync(directory); assert.ok(actual.isDirectory() && !actual.isSymbolicLink());
            assert.equal(actual.dev, identity.dev); assert.equal(actual.ino, identity.ino);
          }
          try {
            sourceGuard();
            const base = fs.realpathSync(process.env.RUNNER_TEMP);
            root = fs.mkdtempSync(path.join(base, 'clero-approved-')); assert.equal(path.dirname(root), base); owner = fs.lstatSync(root);
            marker = path.join(root, '.owner'); token = randomUUID(); fs.writeFileSync(marker, token, { flag: 'wx', mode: 0o600 }); markerOwner = fs.lstatSync(marker);
            fixtures = path.join(root, 'fixtures'); fs.mkdirSync(fixtures, { mode: 0o700 }); fixtureOwner = fs.lstatSync(fixtures);
            const logs = { stdout: path.join(root, 'tap.log'), stderr: path.join(root, 'stderr.log') };
            for (const filename of Object.values(logs)) fs.writeFileSync(filename, '', { flag: 'wx', mode: 0o600 });
            let termination;
            await new Promise(resolve => {
              const child = spawn(process.execPath, ['--test', '--test-concurrency=1', '--test-reporter=tap', '--test-timeout=120000', ...tests], {
                detached: true, stdio: ['ignore', 'pipe', 'pipe'], env: { ...process.env, TMPDIR: fixtures },
              });
              outcome.started = true;
              const signal = name => { try { if (child.pid) process.kill(-child.pid, name); } catch (error) { if (error.code !== 'ESRCH') outcome.controlError = error.message; } };
              const stop = reason => {
                if (outcome.stopReason) return; outcome.stopReason = reason; outcome.timedOut = reason === 'timeout'; signal('SIGTERM');
                termination = new Promise(done => setTimeout(() => { signal('SIGKILL'); done(); }, 3000));
              };
              const timer = setTimeout(() => stop('timeout'), 120000);
              for (const [stream, cap] of [['stdout', 2 * 1024 * 1024], ['stderr', 256 * 1024]]) child[stream].on('data', chunk => {
                outcome[`${stream}Bytes`] += chunk.length;
                if (outcome[`${stream}Bytes`] > cap) stop(`${stream}_cap`);
                else try { fs.appendFileSync(logs[stream], chunk); } catch (error) { outcome.logError = error.message; stop('log_write'); }
              }).on('error', () => stop(`${stream}_error`));
              child.on('error', error => { outcome.spawnError = error.message; });
              child.on('close', (code, signalName) => { clearTimeout(timer); outcome.exitCode = code; outcome.signal = signalName; resolve(); });
            });
            if (termination) await termination;
            const lines = fs.readFileSync(logs.stdout, 'utf8').split(/\r?\n/);
            const names = lines.filter(line => line.startsWith('# Subtest: ')).map(line => line.slice(11));
            const passed = lines.map(line => /^ok (\d+) - (.+)$/.exec(line)).filter(Boolean);
            const totals = {};
            for (const [key, count] of Object.entries({ tests: 72, suites: 0, pass: 72, fail: 0, cancelled: 0, skipped: 0, todo: 0 })) {
              const matches = lines.filter(line => line.startsWith(`# ${key} `));
              totals[key] = matches.length === 1 && new RegExp(`^# ${key} [0-9]+$`).test(matches[0]) ? Number(matches[0].split(' ').at(-1)) : null;
            }
            outcome.totals = totals; outcome.observedCases = names.length;
            for (const name of names.slice(0, 72)) console.log(`case ${JSON.stringify(name.slice(0, 512))}`);
            let diagnosticBudget = 16384;
            for (let index = 0; index < lines.length && diagnosticBudget > 0; index++) {
              if (!/^not ok [0-9]+ - /.test(lines[index])) continue;
              const details = [lines[index]];
              for (let next = index + 1; next < Math.min(lines.length, index + 49) && !lines[next].startsWith('# Subtest: '); next++) details.push(lines[next]);
              const diagnostic = details.join('\n').slice(0, diagnosticBudget);
              diagnosticBudget -= diagnostic.length;
              console.log(`failure ${JSON.stringify(diagnostic)}`);
            }
            assert.equal(outcome.spawnError, undefined); assert.equal(outcome.controlError, undefined); assert.equal(outcome.logError, undefined);
            assert.equal(outcome.stopReason, null); assert.equal(outcome.exitCode, 0); assert.equal(outcome.signal, null);
            equal(totals, { tests: 72, suites: 0, pass: 72, fail: 0, cancelled: 0, skipped: 0, todo: 0 });
            assert.equal(lines.filter(line => line === '1..72').length, 1); assert.ok(!lines.some(line => /^\s*not ok /.test(line)));
            equal(sorted(names), sorted(expected)); equal(sorted(passed.map(match => match[2])), sorted(expected));
            equal(passed.map(match => Number(match[1])), Array.from({ length: 72 }, (_, index) => index + 1));
            console.log(JSON.stringify({ totals, observedCases: names.length }));
          } catch (error) { failed = true; console.error(`checks failed: ${String(error.message).slice(0, 1000)}`); }
          finally {
            try { sourceGuard(); console.log('post-source guard passed'); } catch (error) { failed = true; console.error(`post-source guard failed: ${String(error.message).slice(0, 1000)}`); }
            if (root) {
              try { owned(fixtures, fixtureOwner); equal(fs.readdirSync(fixtures), []); console.log('fixture directory empty'); }
              catch (error) { failed = true; console.error(`fixture guard failed: ${String(error.message).slice(0, 1000)}`); }
              try {
                owned(root, owner); const actual = fs.lstatSync(marker);
                assert.ok(actual.isFile() && !actual.isSymbolicLink()); assert.equal(actual.dev, markerOwner.dev); assert.equal(actual.ino, markerOwner.ino); assert.equal(fs.readFileSync(marker, 'utf8'), token);
                fs.rmSync(root, { recursive: true, force: false }); console.log('owned temporary root removed');
              } catch (error) { failed = true; console.error(`cleanup refused: ${String(error.message).slice(0, 1000)}`); }
            }
            console.log(JSON.stringify({ source: process.env.APPROVED_SOURCE_SHA, ...outcome, failed })); process.exitCode = failed ? 1 : 0;
          }
          NODE
