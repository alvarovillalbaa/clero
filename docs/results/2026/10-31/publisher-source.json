  "testFiles": [
    {
      "path": "tests/cli.test.mjs",
      "names": [
        "T2 CLI init creates a real Markdown project and declared files",
        "T2 CLI check validates a Markdown directory without changing it",
        "T2 CLI build emits actual assets, exact sources and a verified hash manifest",
        "T2 CLI build accepts an exported project bundle and preserves source bytes",
        "T2 CLI init refuses an existing destination and preserves its tree",
        "T2 CLI build refuses an existing destination and preserves input and output",
        "T2 CLI refuses symlink project directory and bundle inputs before output",
        "T2 CLI refuses nested declared-page traversal before output and preserves its owned sibling",
        "T2 CLI refuses symlinked Markdown files and nested Markdown directories",
        "T2 CLI rejects duplicate declared files and duplicate page slugs before output",
        "T2 CLI refuses malformed UTF-8 in Markdown and exported bundles",
        "T2 CLI refuses individual-page and aggregate Markdown byte-budget overflow",
        "T2 CLI rejects missing pages, same-page and cross-page headings, and dangerous links before output",
        "T2 CLI argument errors have a failing exit status and perform no writes"
      ]
    },
    {
      "path": "tests/markdown.test.mjs",
      "names": [
        "HTML escaping protects text and both attribute quote styles",
        "headings expose deterministic namespaced unique Unicode anchors and plain labels",
        "paragraphs blockquotes and horizontal rules render a closed block vocabulary",
        "ordered and unordered lists preserve item order with escaped item text",
        "fenced code escapes source and language while assigning copy controls to code blocks",
        "inline code strong emphasis and escaped punctuation retain searchable text",
        "external HTTP HTTPS and mailto links use validated URLs and safe attributes",
        "relative known Markdown pages and local fragments resolve from the current directory",
        "missing internal pages remain escaped labels with an actionable warning",
        "dangerous malformed and escaping link destinations never become anchors",
        "raw HTML MDX scripts and event-bearing tags remain source text",
        "image syntax produces only its label and never loads local or remote resources",
        "simple tables escape cells preserve reading order and warn on uneven rows",
        "renderer metadata and collections are detached frozen values",
        "renderer limits warnings and rejects invalid Unicode oversized content and accessor options",
        "unclosed code and malformed inline syntax remain deterministic escaped data",
        "resolved link metadata binds page fragments without retaining source destinations",
        "heading allocation is bounded and never collides with reader DOM identities"
      ]
    },
    {
      "path": "tests/model.test.mjs",
      "names": [
        "project normalization supplies exact defaults and detaches frozen data",
        "project normalization accepts data-only null-prototype records and preserves page order",
        "project normalization rejects non-record roots and unsupported or missing schemas",
        "project normalization rejects extra hidden symbol and accessor root fields without reading getters",
        "project pages reject inherited unknown hidden symbol and accessor fields",
        "project page arrays must be dense bounded data without getters or extra fields",
        "project names and titles enforce nonblank single-line character boundaries",
        "project descriptions and groups retain defaults but reject invalid explicit values",
        "project accents accept only six hexadecimal digits and normalize case",
        "slugs retain lowercase nested identities and page hrefs encode their path as query data",
        "slugs reject traversal reserved runtime paths ambiguous encodings and excessive depth",
        "projects reject duplicate slug identities and absent required page fields",
        "projects preserve valid Unicode but reject NUL and isolated surrogate code units",
        "project page limits count UTF-8 bytes and accept the inclusive byte boundary",
        "project aggregate content has an inclusive four MiB byte budget",
        "canonical pretty JSON stays within the five MiB browser import budget after escaping"
      ]
    }
  ],
